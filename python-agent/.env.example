# OpenAI-compatible chat endpoint. DeepSeek is the default; change BASE_URL for others.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
TRADE_SERVICE_BASE_URL=http://localhost:8080

# Local embeddings. These do not use the chat API key, base URL, or model name.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
# Leave EMBEDDING_MAX_DISTANCE unset until a real retrieval evaluation calibrates it.
# The value is a squared L2 distance. Smaller means closer.
